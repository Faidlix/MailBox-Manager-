PORT=4141
HOST=127.0.0.1
# Optional. Defaults to ./data/mailbox.db
MAILBOX_DB_PATH=
# Number of newest messages fetched per account (1-1000)
SYNC_LIMIT=1000
# Backend-only settings; never put real values in tracked files or the browser.
MAILBOX_PUBLIC_ORIGIN=http://127.0.0.1:4141
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
